# ─────────────────────────────────────────────────────────────────────────────
# Tob Daniel Business Enterprise — environment configuration
# Copy this file to `.env` and adjust the values. Never commit `.env`.
# ─────────────────────────────────────────────────────────────────────────────

# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# First-boot seeding: if "true" and the products table is empty, sample data
# is seeded automatically on server start (handy for cloud deploys).
AUTO_SEED=false

# SECURITY — secret used to sign auth tokens (JWT) and hash sessions.
# If left empty, a random secret is generated once and stored in data/secret.key.
APP_SECRET=

# Database file location (SQLite). Leave default for local dev.
# DB_PATH=./data/store.db

# The admin login route. Change this to make the dashboard harder to guess.
# Example: ADMIN_ROUTE=my-private-panel-9f3a
ADMIN_ROUTE=secure-admin-login

# Optional: comma-separated list of extra admin emails (created on first seed)
# ADMIN_EMAILS=

# ─────────────────────────────────────────────────────────────────────────────
# PAYMENT PROVIDERS (optional — the platform works with Pay-on-Delivery /
# Bank transfer without any credentials. Card payments activate only when
# keys are provided.)
# ─────────────────────────────────────────────────────────────────────────────
# PAYSTACK_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxx
# PAYSTACK_PUBLIC_KEY=pk_live_xxxxxxxxxxxxxxxx
# FLUTTERWAVE_SECRET_KEY=FLWSECK-xxxxxxxx
# STRIPE_SECRET_KEY=sk_live_xxxxxxxx

# ─────────────────────────────────────────────────────────────────────────────
# SMTP (optional) — used to email order confirmations and notifications.
# Without it, emails are logged to the server console.
# ─────────────────────────────────────────────────────────────────────────────
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=no-reply@tobdaniel.ng
# SMTP_PASS=yourpassword
# MAIL_FROM="Tob Daniel Business Enterprise <no-reply@tobdaniel.ng>"
